# Dependências: reinstaláveis a partir do package-lock.json
node_modules/

# Saída do build (npm run build)
dist/

# Capturas que os scripts de teste geram em tools/.
# O padrão é só imagem: tools/_servidor.mjs também começa com "_" e é código.
tools/_*.png
tools/_debug*

# Logs e caches de ferramenta
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.vite/
.eslintcache

# Variáveis de ambiente
.env
.env.*
!.env.example

# Editores
.vscode/
.idea/
*.swp
*~

# Sistema operacional
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# Os modelos e sons FICAM versionados de propósito: sem eles o jogo não roda
# depois de um clone, e juntos dão pouco mais de 1 MB.
