# Dependências: reinstaláveis a partir do package-lock.json
node_modules/

# Saída do build (npm run build) e o pacote de publicação (npm run itch)
dist/
*.zip
introduction

# Sobras dos scripts de teste em tools/.
# Só imagens e arquivos temporários: tools/_servidor.mjs começa com "_" e é
# código de verdade, usado por todos os testes de navegador.
tools/_*.png
tools/_*.jpg
tools/_debug*
tools/_patch*
tools/_tmp*

# Logs e caches de ferramenta
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.vite/
vite.config.js.timestamp-*
.eslintcache

# Variáveis de ambiente
.env
.env.*
!.env.example
*.local

# Editores
.vscode/
.idea/
*.swp
*~

# Sistema operacional
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# Arquivos markdown de anotações
bugs e melhorias.md
planejamento.md
Poki_SDK.md

# ---------------------------------------------------------------------------
# Fica versionado de propósito:
#   models/        os FBX e texturas originais
#   public/models/ a cópia servida ao navegador, com nomes normalizados
#   public/audios/ os sons da abertura
#   audios/        os originais desses sons
# São pouco mais de 1 MB no total, e sem eles o jogo não roda depois de um
# clone — o loader busca tudo por caminho fixo em /models e /audios.
